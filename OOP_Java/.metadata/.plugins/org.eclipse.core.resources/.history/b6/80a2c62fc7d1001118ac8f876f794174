
public class Person {
	private String name;
	private int age;
	public static int personCount;
	public Person(){
		name="Mickey";
		age=25;
	}

	public Person(int age, String name) {
		this.age = age;
		this.name = name;
	}

	public Person(String name, int age) {
		super();
		this.name = name;
		this.age = age;
	}

	

}
