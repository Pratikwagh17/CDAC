
public class ArrayAsParameterMain {
	
	public static double[] getSquareRoots(int[] allNumbers) {
		int size=allNumbers.length;
		double[] allSquareRoots= new double[size];
		int index=0;
		for(int everyNumber : allNumbers) {
			double squareRoots=Math.sqrt(everyNumber);
			allSquareRoots[index]=squareRoots;
			index++;
		}
		return allSquareRoots;
		
	}

